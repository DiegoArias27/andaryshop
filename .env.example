# Base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:4000/api

# WhatsApp number that receives orders, in international format without symbols
# e.g. 521234567890
VITE_WHATSAPP_NUMBER=521234567890

# Footer contact info (all optional — sensible placeholders are used if omitted)
VITE_STORE_ADDRESS=Av. Reforma 123, Col. Centro, CDMX
VITE_INSTAGRAM_URL=https://instagram.com/andaryshop
VITE_FACEBOOK_URL=https://facebook.com/andaryshop
VITE_TIKTOK_URL=https://tiktok.com/@andaryshop
